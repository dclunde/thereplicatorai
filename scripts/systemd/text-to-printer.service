[Unit]
Description=Text-to-Printer Multi-Service Supervisor & Auto-Updater
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/text_to_printer
ExecStart=/usr/local/bin/uv run python -m src.cli.supervisor
Restart=always
RestartSec=10
EnvironmentFile=/opt/text_to_printer/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
