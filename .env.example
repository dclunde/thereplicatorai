# ==============================================================================
# Text-to-Printer Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# .env is strictly git-ignored and read-only.

# AI Provider API Keys (Configure the key matching active_provider in inputs/configs/ai_models.json)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Remote Telegram Bot (Optional, for src/bots/telegram/bot.py)
TELEGRAM_BOT_TOKEN=

# Google Tasks Bot OAuth Client Credentials (Optional, for src/bots/google_tasks/bot.py)
# Post-authentication token is automatically cached in outputs/.cache/google_tasks_token.json
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=

# Bambu Lab Cloud Credentials (Optional if using LAN Mode)
BAMBU_USERNAME=
BAMBU_PASSWORD=
BAMBU_DEVICE_SERIAL=

# Bambu Lab Local / LAN Mode Credentials (Recommended for local printing)
BAMBU_PRINTER_IP=
BAMBU_ACCESS_CODE=
